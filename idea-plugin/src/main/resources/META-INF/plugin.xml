<idea-plugin>
    <vendor>75542</vendor>
    <description><![CDATA[
    NameLens「见名知意」：为英语一般、读规范命名代码的 Java 开发者做的伴读插件。<br/>
    <ul>
      <li>选中/光标放方法上 → 中文解释卡片：命名逐词拆解（resolveUserPrincipal → 解析/用户/已认证主体）、入参含义、返回值、作用，本地缓存秒出</li>
      <li>一键生成仓库术语表（类名/方法名/缩写 中英对照，Markdown + 工具窗口可搜索）</li>
      <li>一键生成 Spring 请求链路图（Filter/Security → Interceptor → Controller → Service → Mapper → Redis/MQ/DB，Mermaid 渲染，结构来自静态扫描、语义由 LLM 补充）</li>
      <li>选中代码问 git 历史："这段代码为什么这样写"（事实与推断分开呈现）</li>
    </ul>
    使用任意 OpenAI 兼容 API（智谱 GLM / DeepSeek / Ollama 本地），在 Settings → Tools → NameLens 配置。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.namelens.settings.NameLensSettings"/>
        <applicationConfigurable parentId="tools"
                                 id="NameLens.Settings"
                                 displayName="NameLens"
                                 instance="com.namelens.settings.NameLensConfigurable"/>
        <projectService serviceImplementation="com.namelens.cache.NameLensCache"/>
        <toolWindow id="NameLens"
                    anchor="right"
                    factoryClass="com.namelens.ui.NameLensToolWindowFactory"
                    canCloseContents="true"/>
        <notificationGroup id="NameLens" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="NameLens.Explain"
                class="com.namelens.action.ExplainAction"
                text="NameLens: 中文解释此方法"
                description="解释选中/光标处方法：命名逐词拆解、入参、返回值、作用（中文）">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift E"/>
        </action>
        <action id="NameLens.GitWhy"
                class="com.namelens.action.GitWhyAction"
                text="NameLens: 这段代码为什么这样写"
                description="结合 git blame/log 与 LLM，用中文解释选中代码的来历与原因">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift G"/>
        </action>
        <group id="NameLens.Tools" text="NameLens 见名知意" popup="true" description="仓库级：术语表与链路图">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="NameLens.Glossary"
                    class="com.namelens.action.GlossaryAction"
                    text="生成仓库术语表（中英对照）"
                    description="扫描项目类名/方法名/字段名，LLM 批量生成中英术语表"/>
            <action id="NameLens.FlowDiagram"
                    class="com.namelens.action.FlowDiagramAction"
                    text="生成请求链路图（Spring）"
                    description="静态扫描 Spring 组件 + LLM 补语义，生成 Mermaid 请求链路图"/>
        </group>
    </actions>
</idea-plugin>
